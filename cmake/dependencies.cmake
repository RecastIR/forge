if(FORGE_PRESET AND FORGE_CONFIGURED_PRESET AND NOT FORGE_PRESET STREQUAL FORGE_CONFIGURED_PRESET)
  message(FATAL_ERROR "This build directory belongs to '${FORGE_CONFIGURED_PRESET}', not '${FORGE_PRESET}'. Select a separate build directory.")
endif()
if(FORGE_PRESET)
  set(provision_help "Run make provision PRESET=${FORGE_PRESET} BUILD_DIR=\"${binary_dir}\" and configure this directory again.")
  if(EXISTS "${CMAKE_BINARY_DIR}/CMakeCache.txt" AND NOT FORGE_CONFIGURED_PRESET AND
     DEFINED CMAKE_PROJECT_NAME AND NOT FORGE_CONAN_PRESET STREQUAL FORGE_PRESET)
    message(FATAL_ERROR "This build directory already has an unmanaged CMake cache. Use a fresh build directory.")
  endif()
  get_filename_component(toolchain_path "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  if(NOT EXISTS "${toolchain_path}")
    message(FATAL_ERROR "Missing dependency toolchain for '${FORGE_PRESET}' at '${toolchain_path}'. ${provision_help}")
  endif()
else()
  set(provision_help "Run make provision PRESET=dev, then cmake --preset dev.")
endif()
if(EXISTS "${build_root}/CMakeCache.txt")
  message(WARNING "Found a legacy cache at '${build_root}/CMakeCache.txt'. Keep using the nested presets. "
    "Save useful artifacts and retire the old cache separately; moving a cache does not relocate a build.")
endif()

# Conan writes its recipe variables as CMake cache defaults. Reload them from
# the actual toolchain on every configure, including after reprovisioning.
get_cmake_property(cached_variables CACHE_VARIABLES)
foreach(variable IN LISTS cached_variables)
  if(variable MATCHES "^FORGE_CONAN_")
    unset(${variable} CACHE)
  endif()
endforeach()

function(forge_check_dependencies)
  if(NOT DEFINED FORGE_CONAN_PRESET)
    option(FORGE_BUILD_CLI "Build the Forge CLI" ON)
    if(FORGE_PRESET OR FORGE_BUILD_CLI)
      message(FATAL_ERROR "Forge's CLI requires its provisioned Conan toolchain. ${provision_help} "
        "A standalone core or harness build can use -DFORGE_BUILD_CLI=OFF.")
    endif()
    return()
  endif()

  if(FORGE_PRESET AND NOT FORGE_PRESET STREQUAL FORGE_CONAN_PRESET)
    message(FATAL_ERROR "The toolchain was provisioned for '${FORGE_CONAN_PRESET}', not '${FORGE_PRESET}'. ${provision_help}")
  endif()
  if(FORGE_CONFIGURED_PRESET AND NOT FORGE_CONFIGURED_PRESET STREQUAL FORGE_CONAN_PRESET)
    message(FATAL_ERROR "This cache and the provisioned toolchain belong to different Forge presets. Use a fresh build directory.")
  endif()
  if(DEFINED FORGE_CONFIGURED_PROFILE_ID AND NOT FORGE_CONFIGURED_PROFILE_ID STREQUAL FORGE_CONAN_PROFILE_ID)
    message(FATAL_ERROR "The provisioned compiler profile differs from this CMake cache. Use a fresh build directory.")
  endif()
  get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(NOT CMAKE_GENERATOR STREQUAL FORGE_CONAN_GENERATOR OR
     (NOT multi_config AND NOT CMAKE_BUILD_TYPE STREQUAL FORGE_CONAN_BUILD_TYPE))
    message(FATAL_ERROR "The generator or build type does not match the provisioned toolchain "
      "(${FORGE_CONAN_GENERATOR}, ${FORGE_CONAN_BUILD_TYPE}). ${provision_help}")
  endif()

  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    message(FATAL_ERROR "The Conan profile requires a macOS arm64 build. Check the selected SDK and architecture.")
  endif()
  if(IS_DIRECTORY "${CMAKE_OSX_SYSROOT}" AND EXISTS "${CMAKE_OSX_SYSROOT}/SDKSettings.json")
    file(READ "${CMAKE_OSX_SYSROOT}/SDKSettings.json" sdk_settings)
    string(JSON sdk_name GET "${sdk_settings}" CanonicalName)
  else()
    set(sdk_name "${CMAKE_OSX_SYSROOT}")
  endif()
  string(TOLOWER "${sdk_name}" sdk_name)
  if(NOT sdk_name MATCHES "^macosx([0-9.]+)?$")
    message(FATAL_ERROR "Expected a macOS SDK for the Conan profile, got '${CMAKE_OSX_SYSROOT}'.")
  endif()
  string(REPLACE "." "[.]" version_pattern "${FORGE_CONAN_COMPILER_VERSION}")
  foreach(language C CXX)
    if(NOT CMAKE_${language}_COMPILER_ID STREQUAL FORGE_CONAN_COMPILER OR
       NOT CMAKE_${language}_COMPILER_VERSION MATCHES "^${version_pattern}([.]|$)")
      message(FATAL_ERROR "The ${language} compiler ${CMAKE_${language}_COMPILER} "
        "(${CMAKE_${language}_COMPILER_ID} ${CMAKE_${language}_COMPILER_VERSION}) differs from the "
        "Conan profile (${FORGE_CONAN_COMPILER} ${FORGE_CONAN_COMPILER_VERSION}). ${provision_help}")
    endif()
  endforeach()
  if((FORGE_PRESET STREQUAL "sanitize" AND NOT FORGE_ENABLE_SANITIZERS) OR
     (FORGE_PRESET AND NOT FORGE_PRESET STREQUAL "sanitize" AND FORGE_ENABLE_SANITIZERS))
    message(FATAL_ERROR "FORGE_ENABLE_SANITIZERS conflicts with the '${FORGE_PRESET}' preset. Use the sanitize preset for instrumentation.")
  endif()
  if(FORGE_CONAN_PRESET STREQUAL "lint")
    if(FORGE_PRESET AND (NOT CMAKE_EXPORT_COMPILE_COMMANDS OR BUILD_TESTING))
      message(FATAL_ERROR "The lint preset requires CMAKE_EXPORT_COMPILE_COMMANDS=ON and BUILD_TESTING=OFF.")
    endif()
    foreach(tool clang clang++)
      forge_llvm_tool("${tool}")
    endforeach()
    file(REAL_PATH "${CMAKE_C_COMPILER}" c_compiler)
    file(REAL_PATH "${CMAKE_CXX_COMPILER}" cxx_compiler)
    file(REAL_PATH "${clang}" selected_c)
    file(REAL_PATH "${clang++}" selected_cxx)
    if(NOT c_compiler STREQUAL selected_c OR NOT cxx_compiler STREQUAL selected_cxx)
      message(FATAL_ERROR "Lint must use the compilers from the selected LLVM installation. ${provision_help}")
    endif()
  endif()

  if(DEFINED FORGE_BUILD_CLI AND ((FORGE_BUILD_CLI AND NOT FORGE_CONAN_WITH_CLI) OR
                                  (NOT FORGE_BUILD_CLI AND FORGE_CONAN_WITH_CLI)))
    message(FATAL_ERROR "FORGE_BUILD_CLI disagrees with the provisioned Conan with_cli option. Select with_cli during provisioning.")
  endif()
  if(FORGE_CONAN_WITH_CLI)
    if(multi_config)
      set(build_types "${CMAKE_CONFIGURATION_TYPES}")
    else()
      set(build_types "${CMAKE_BUILD_TYPE}")
    endif()
    foreach(build_type IN LISTS build_types)
      string(TOLOWER "${build_type}" config)
      if(NOT EXISTS "${FORGE_CONAN_DIRECTORY}/CLI11Config.cmake" OR
         NOT EXISTS "${FORGE_CONAN_DIRECTORY}/CLI11-Target-${config}.cmake")
        message(FATAL_ERROR "Missing CLI11 integration for ${build_type} in '${FORGE_CONAN_DIRECTORY}'. ${provision_help}")
      endif()
    endforeach()
  endif()
  set(FORGE_BUILD_CLI "${FORGE_CONAN_WITH_CLI}" CACHE BOOL "Build the Forge CLI")
  set(FORGE_CONFIGURED_PRESET "${FORGE_CONAN_PRESET}" CACHE INTERNAL "Preset owning this build directory")
  set(FORGE_CONFIGURED_PROFILE_ID "${FORGE_CONAN_PROFILE_ID}" CACHE INTERNAL "Provisioned compiler profile")
endfunction()
