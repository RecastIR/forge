# Select the same LLVM installation in project and quality-script mode.
foreach(selector LLVM_DIR LLVM_CONFIG)
  if(NOT "$ENV{${selector}}" STREQUAL "")
    if(${selector} AND NOT "${${selector}}" STREQUAL "$ENV{${selector}}")
      file(REAL_PATH "${${selector}}" selected_path)
      file(REAL_PATH "$ENV{${selector}}" env_path)
      if(NOT selected_path STREQUAL env_path)
        message(FATAL_ERROR "Conflicting ${selector}: ${${selector}} and environment $ENV{${selector}}. Select one installation or use a fresh build directory.")
      endif()
    endif()
    set(${selector} "$ENV{${selector}}")
  endif()
endforeach()

set(forge_stable_llvm "^23\\.[0-9]+\\.[0-9]+$")
function(forge_check_llvm_version version)
  if(NOT version MATCHES "${forge_stable_llvm}")
    message(FATAL_ERROR "Forge requires stable LLVM 23.x, found '${version}'. Set LLVM_DIR to its CMake package or LLVM_CONFIG to its llvm-config.")
  endif()
endfunction()

function(forge_config_query option output)
  execute_process(COMMAND "${llvm_config}" "${option}" OUTPUT_VARIABLE value
                  OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status STREQUAL "0" OR NOT value)
    message(FATAL_ERROR "Cannot run '${llvm_config} ${option}': ${status} ${error}. Check LLVM_DIR and LLVM_CONFIG.")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

if(LLVM_DIR)
  if(NOT EXISTS "${LLVM_DIR}/LLVMConfig.cmake")
    message(FATAL_ERROR "Invalid LLVM_DIR='${LLVM_DIR}': expected LLVMConfig.cmake in this directory.")
  endif()
  file(REAL_PATH "${LLVM_DIR}" LLVM_DIR)
endif()
if(LLVM_CONFIG)
  set(llvm_config "${LLVM_CONFIG}")
elseif(NOT LLVM_DIR)
  set(hints)
  if(CMAKE_HOST_APPLE)
    execute_process(COMMAND brew --prefix OUTPUT_VARIABLE brew_prefix
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(brew_prefix)
      list(APPEND hints "${brew_prefix}/opt/llvm@23/bin" "${brew_prefix}/opt/llvm/bin")
    endif()
  endif()
  file(TO_CMAKE_PATH "$ENV{PATH}" path_dirs)
  foreach(dir IN LISTS hints path_dirs)
    foreach(name llvm-config-23 llvm-config)
      if(EXISTS "${dir}/${name}")
        execute_process(COMMAND "${dir}/${name}" --version OUTPUT_VARIABLE version
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(rc STREQUAL "0" AND version MATCHES "${forge_stable_llvm}")
          set(llvm_config "${dir}/${name}")
          break()
        endif()
      endif()
    endforeach()
    if(llvm_config)
      break()
    endif()
  endforeach()
  if(NOT llvm_config)
    message(FATAL_ERROR "Forge requires stable LLVM 23.x. Set LLVM_DIR or LLVM_CONFIG to your LLVM 23 installation.")
  endif()
endif()

if(llvm_config)
  forge_config_query(--cmakedir config_package)
  file(REAL_PATH "${config_package}" config_package)
  if(LLVM_DIR AND NOT LLVM_DIR STREQUAL config_package)
    message(FATAL_ERROR "Conflicting LLVM_DIR='${LLVM_DIR}' and llvm-config package '${config_package}'. Select one LLVM installation.")
  endif()
  set(LLVM_DIR "${config_package}")
  if(NOT EXISTS "${LLVM_DIR}/LLVMConfig.cmake")
    message(FATAL_ERROR "Missing LLVMConfig.cmake in '${LLVM_DIR}' reported by '${llvm_config}'.")
  endif()
endif()
if(NOT CMAKE_SCRIPT_MODE_FILE)
  set(LLVM_DIR "${LLVM_DIR}" CACHE PATH "LLVM CMake package directory" FORCE)
  find_package(LLVM REQUIRED CONFIG PATHS "${LLVM_DIR}" NO_DEFAULT_PATH)
  forge_check_llvm_version("${LLVM_PACKAGE_VERSION}")
  if(NOT llvm_config)
    set(llvm_config "${LLVM_TOOLS_BINARY_DIR}/llvm-config")
  endif()
elseif(NOT llvm_config)
  # Installed packages place lib/cmake/llvm and bin under the same prefix.
  set(llvm_config "${LLVM_DIR}/../../../bin/llvm-config")
endif()
forge_config_query(--version llvm_version)
forge_check_llvm_version("${llvm_version}")
forge_config_query(--bindir llvm_bin)
file(REAL_PATH "${llvm_bin}" llvm_bin)
if(CMAKE_SCRIPT_MODE_FILE AND NOT config_package)
  forge_config_query(--cmakedir config_package)
  file(REAL_PATH "${config_package}" config_package)
  if(NOT LLVM_DIR STREQUAL config_package)
    message(FATAL_ERROR "Conflicting LLVM_DIR='${LLVM_DIR}' and llvm-config package '${config_package}'.")
  endif()
elseif(NOT CMAKE_SCRIPT_MODE_FILE)
  file(REAL_PATH "${LLVM_TOOLS_BINARY_DIR}" package_bin)
  if(NOT LLVM_PACKAGE_VERSION STREQUAL llvm_version OR NOT package_bin STREQUAL llvm_bin)
    message(FATAL_ERROR "LLVM package reports ${LLVM_PACKAGE_VERSION} (${package_bin}); llvm-config reports ${llvm_version} (${llvm_bin}). Check LLVM_DIR and LLVM_CONFIG.")
  endif()
endif()
message(STATUS "Using LLVM ${llvm_version} at ${LLVM_DIR} (tools: ${llvm_bin})")

function(forge_llvm_tool name)
  unset(program CACHE)
  find_program(program NAMES "${name}" PATHS "${llvm_bin}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
  if(NOT program)
    message(FATAL_ERROR "Missing required LLVM tool '${name}' in ${llvm_bin}. Select a complete LLVM 23 installation.")
  endif()
  set(path "${program}")
  unset(program CACHE)
  # Preserve explicit aliases, but discard paths cached for a former package.
  if(${name} AND (FORGE_${name}_PACKAGE STREQUAL LLVM_DIR OR NOT "${${name}}" STREQUAL "${FORGE_${name}_PATH}"))
    file(REAL_PATH "${${name}}" supplied)
    file(REAL_PATH "${path}" actual)
    if(NOT supplied STREQUAL actual)
      message(FATAL_ERROR "Conflicting ${name}='${${name}}': selected LLVM provides ${path}. Remove the override or select its LLVM_DIR.")
    endif()
    set(path "${${name}}")
  endif()
  set("${name}" "${path}" CACHE FILEPATH "Selected LLVM ${name}" FORCE)
  set("FORGE_${name}_PACKAGE" "${LLVM_DIR}" CACHE INTERNAL "LLVM package for ${name}")
  set("FORGE_${name}_PATH" "${path}" CACHE INTERNAL "Previous ${name} selection")
  set("${name}" "${path}" PARENT_SCOPE)
  message(STATUS "  ${name}: ${path}")
endfunction()
