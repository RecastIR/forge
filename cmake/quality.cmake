cmake_minimum_required(VERSION 3.20)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." root)
file(GLOB sources "${root}/src/*.cpp")
list(APPEND sources "${root}/tests/native_harness.cpp")

if(LLVM_CONFIG)
  set(llvm_config "${LLVM_CONFIG}")
else()
  find_program(llvm_config llvm-config)
  if(NOT llvm_config AND CMAKE_HOST_APPLE)
    find_program(brew brew)
    if(brew)
      execute_process(COMMAND "${brew}" --prefix OUTPUT_VARIABLE prefix
                      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
      file(GLOB versions "${prefix}/opt/llvm@*")
      list(SORT versions COMPARE NATURAL ORDER DESCENDING)
      find_program(llvm_config llvm-config HINTS "${prefix}/opt/llvm" ${versions} PATH_SUFFIXES bin)
    endif()
  endif()
endif()

if(llvm_config)
  execute_process(COMMAND "${llvm_config}" --bindir OUTPUT_VARIABLE llvm_bin
                  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
if(ACTION STREQUAL "lint")
  set(tool clang-tidy)
else()
  set(tool clang-format)
endif()
if(LLVM_CONFIG OR (llvm_bin AND ACTION STREQUAL "lint" AND NOT LINT_DATABASE))
  find_program(executable "${tool}" PATHS "${llvm_bin}" NO_DEFAULT_PATH)
else()
  find_program(executable "${tool}" HINTS "${llvm_bin}")
endif()
if(NOT executable)
  message(FATAL_ERROR "${ACTION} requires ${tool}. Install LLVM or select it with LLVM_CONFIG=/path/to/llvm-config.")
endif()

if(NOT ACTION STREQUAL "lint")
  file(GLOB headers "${root}/src/*.h")
  if(ACTION STREQUAL "format")
    set(flags -i)
  elseif(ACTION STREQUAL "format-check")
    set(flags --dry-run --Werror)
  else()
    message(FATAL_ERROR "Unknown quality command: ${ACTION}")
  endif()
  execute_process(COMMAND "${executable}" ${flags} ${sources} ${headers} COMMAND_ERROR_IS_FATAL ANY)
  return()
endif()

if(NOT LINT_DATABASE)
  if(NOT llvm_config)
    message(FATAL_ERROR "The lint build requires llvm-config. Set LLVM_CONFIG or supply LINT_DATABASE=/path/to/compile_commands.json.")
  endif()
  if(NOT LLVM_DIR)
    execute_process(COMMAND "${llvm_config}" --cmakedir OUTPUT_VARIABLE LLVM_DIR
                    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  endif()
  if(CMAKE_HOST_APPLE)
    set(sdk -DCMAKE_OSX_SYSROOT=macosx)
  endif()
  file(LOCK "${BUILD_DIR}/forge-lint.lock" GUARD PROCESS)
  if(EXISTS "${BUILD_DIR}/CMakeCache.txt")
    load_cache("${BUILD_DIR}" READ_WITH_PREFIX cached_ CMAKE_HOME_DIRECTORY CMAKE_CXX_COMPILER)
    if(cached_CMAKE_HOME_DIRECTORY STREQUAL root AND
       NOT cached_CMAKE_CXX_COMPILER STREQUAL "${llvm_bin}/clang++")
      # CMake discards command-line settings when it redetects a changed compiler.
      # Start the dedicated analysis cache fresh so the SDK and database flags survive.
      file(REMOVE "${BUILD_DIR}/CMakeCache.txt")
    endif()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${BUILD_DIR}" -G "Unix Makefiles"
    "-DCMAKE_C_COMPILER=${llvm_bin}/clang" "-DCMAKE_CXX_COMPILER=${llvm_bin}/clang++"
    "-DLLVM_DIR=${LLVM_DIR}" ${sdk} -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=OFF
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON COMMAND_ERROR_IS_FATAL ANY)
  set(LINT_DATABASE "${BUILD_DIR}/compile_commands.json")
endif()

get_filename_component(database "${LINT_DATABASE}" ABSOLUTE)
get_filename_component(directory "${database}" DIRECTORY)
get_filename_component(filename "${database}" NAME)
set(regenerate "Regenerate with make configure CMAKE_ARGS=-DCMAKE_EXPORT_COMPILE_COMMANDS=ON using Unix Makefiles or Ninja, or run make lint without LINT_DATABASE.")
if(NOT filename STREQUAL "compile_commands.json" OR NOT EXISTS "${database}")
  message(FATAL_ERROR "Expected compile_commands.json at ${database}. ${regenerate}")
endif()
# clang-tidy can infer a command for a missing file. Require a real command for each input.
file(READ "${database}" commands)
string(JSON count LENGTH "${commands}")
set(missing ${sources})
math(EXPR last "${count} - 1")
if(count GREATER 0)
  foreach(i RANGE 0 ${last})
    string(JSON file GET "${commands}" ${i} file)
    string(JSON cwd GET "${commands}" ${i} directory)
    file(REAL_PATH "${file}" file BASE_DIRECTORY "${cwd}")
    list(REMOVE_ITEM missing "${file}")
  endforeach()
endif()
if(missing)
  list(JOIN missing "\n  " names)
  message(FATAL_ERROR "Missing first-party compile commands in ${database}:\n  ${names}\n${regenerate}")
endif()
execute_process(COMMAND "${executable}" -p "${directory}" ${sources} COMMAND_ERROR_IS_FATAL ANY)
