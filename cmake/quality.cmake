cmake_minimum_required(VERSION 3.20)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." root)

include("${CMAKE_CURRENT_LIST_DIR}/llvm.cmake")
if(ACTION STREQUAL "lint")
  forge_llvm_tool(clang-tidy)
  set(executable "${clang-tidy}")
elseif(ACTION MATCHES "^format(-check|-audit)?$")
  forge_llvm_tool(clang-format)
  set(executable "${clang-format}")
else()
  message(FATAL_ERROR "Unknown quality command: ${ACTION}")
endif()
execute_process(COMMAND "${executable}" --version OUTPUT_VARIABLE banner COMMAND_ERROR_IS_FATAL ANY)
if(NOT banner MATCHES "version 23[.]1[.]5([ \r\n]|$)")
  message(FATAL_ERROR "Forge quality checks require ${executable} version 23.1.5. Select the CI release with LLVM_CONFIG or LLVM_DIR. Found: ${banner}")
endif()
find_program(python NAMES python3 REQUIRED)
set(style "${CMAKE_CURRENT_LIST_DIR}/style.py")
if(NOT ACTION STREQUAL "lint")
  execute_process(COMMAND "${python}" -B "${style}" "${ACTION}" "${executable}"
    WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
  return()
endif()

execute_process(COMMAND "${executable}" --verify-config "--config-file=${root}/.clang-tidy"
  WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${python}" -B "${style}" native-sources
  WORKING_DIRECTORY "${root}" OUTPUT_VARIABLE source_list OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" sources "${source_list}")
if(NOT LINT_DATABASE)
  forge_llvm_tool(clang)
  forge_llvm_tool(clang++)
  if(CMAKE_HOST_APPLE)
    set(sdk -DCMAKE_OSX_SYSROOT=macosx)
  endif()
  file(LOCK "${BUILD_DIR}/forge-lint.lock" GUARD PROCESS)
  if(EXISTS "${BUILD_DIR}/CMakeCache.txt")
    load_cache("${BUILD_DIR}" READ_WITH_PREFIX cached_ CMAKE_HOME_DIRECTORY CMAKE_CXX_COMPILER)
    if(cached_CMAKE_HOME_DIRECTORY STREQUAL root AND
       NOT cached_CMAKE_CXX_COMPILER STREQUAL "${clang++}")
      # CMake discards command-line settings when it redetects a changed compiler.
      # Start the dedicated analysis cache fresh so the SDK and database flags survive.
      file(REMOVE "${BUILD_DIR}/CMakeCache.txt")
    endif()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${BUILD_DIR}" -G "Unix Makefiles"
    "-DCMAKE_C_COMPILER=${clang}" "-DCMAKE_CXX_COMPILER=${clang++}"
    "-DLLVM_DIR=${LLVM_DIR}" ${sdk} -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=OFF
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON COMMAND_ERROR_IS_FATAL ANY)
  set(LINT_DATABASE "${BUILD_DIR}/compile_commands.json")
endif()

get_filename_component(database "${LINT_DATABASE}" ABSOLUTE)
get_filename_component(directory "${database}" DIRECTORY)
get_filename_component(filename "${database}" NAME)
set(regenerate "Regenerate with make configure CMAKE_ARGS=-DCMAKE_EXPORT_COMPILE_COMMANDS=ON using Unix Makefiles or Ninja, or run make lint without LINT_DATABASE.")
if(NOT filename STREQUAL "compile_commands.json" OR NOT EXISTS "${database}")
  message(FATAL_ERROR "Expected compile_commands.json at ${database}. ${regenerate}")
endif()
# clang-tidy can infer a command for a missing file. Require a real command for each input.
file(READ "${database}" commands)
string(JSON count LENGTH "${commands}")
set(missing ${sources})
math(EXPR last "${count} - 1")
if(count GREATER 0)
  foreach(i RANGE 0 ${last})
    string(JSON file GET "${commands}" ${i} file)
    string(JSON cwd GET "${commands}" ${i} directory)
    file(REAL_PATH "${file}" file BASE_DIRECTORY "${cwd}")
    list(REMOVE_ITEM missing "${file}")
  endforeach()
endif()
if(missing)
  list(JOIN missing "\n  " names)
  message(FATAL_ERROR "Missing first-party compile commands in ${database}:\n  ${names}\n${regenerate}")
endif()
forge_config_query(--includedir llvm_include)
execute_process(COMMAND "${python}" -B "${CMAKE_CURRENT_LIST_DIR}/lint.py" "${llvm_include}"
  "${executable}" -p "${directory}" ${sources} WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
